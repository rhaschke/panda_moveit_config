<launch>
  <!-- By default we will load the gripper -->
  <arg name="load_gripper" default="true" />

  <!-- Gazebo specific options -->
  <arg name="gazebo_gui" default="true" />
  <arg name="paused" default="false" />

  <!-- Launch the gazebo simulator and spawn the robot -->
  <include file="$(dirname)/gazebo.launch" pass_all_args="true">
    <arg name="headless" value="$(eval not arg('gazebo_gui'))" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_gripper" default="$(arg load_gripper)" />
    <arg name="transmission" value="hardware_interface/EffortJointInterface" />
  </include>

  <include file="$(dirname)/demo.launch" pass_all_args="true">
    <!-- robot description is loaded by gazebo.launch, to enable Gazebo features -->
    <arg name="load_robot_description" value="false" />
    <!-- Gazebo uses ros_control package to actuate joints -->
    <arg name="moveit_controller_manager" value="ros_control" />
  </include>
</launch>
